{
  "schema": "rhymelab-de-writer-page-plan-v2",
  "language": "de",
  "version": "de-writer-page-v2",
  "description": "Deterministic German writer-page quality benchmark. Structural gates are source/runtime-derived; NDCG@10/20 is enabled only when independent human usefulness labels are supplied.",
  "sampling": {
    "writer_limit": 250,
    "legacy_limit": 250,
    "candidate_pool": 800,
    "page_cutoffs": [10, 20],
    "review_candidate_depth": 40,
    "include_historical": false,
    "include_variants": false
  },
  "provisional_gates": {
    "top20_aggregate_unranked_rows_max": 2,
    "top20_aggregate_usage_rank_over_250k_rows_max": 2,
    "top20_aggregate_explicit_rare_or_historical_rows_max": 0,
    "top20_aggregate_repeated_family_rows_max": 2,
    "required_regressions_must_pass": true
  },
  "reference_review": {
    "source": "independent_human_review",
    "label": "songwriting_usefulness",
    "values": [0, 1, 2, 3, 4],
    "ndcg_cutoffs": [10, 20],
    "require_complete_writer_cutoff_for_ndcg": true,
    "note": "No LLM/ML reference labels are required. Structural benchmark output is valid without reviews; NDCG remains pending until human labels cover the relevant writer cutoff."
  },
